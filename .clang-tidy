Checks: '*,-fuchsia-*,-google-*,-zircon-*,-abseil-*,-llvmlibc-*,-llvm-*,-modernize-use-trailing-return-type,-modernize-use-nodiscard,-hicpp-braces-around-statements,-hicpp-avoid-c-arrays,-hicpp-no-array-decay,-*-uppercase-literal-suffix,-readability-braces-around-statements,-readability-convert-member-functions-to-static,-readability-magic-numbers,-readability-function-cognitive-complexity,-readability-identifier-length,-misc-non-private-member-variables-in-classes,-altera-*,-android-*,-modernize-avoid-c-arrays,-cppcoreguidelines-pro-bounds-array-to-pointer-decay,-cppcoreguidelines-avoid-c-arrays,-cppcoreguidelines-avoid-magic-numbers,-hicpp-use-auto,-modernize-use-auto,-hicpp-signed-bitwise,-bugprone-easily-swappable-parameters,-cppcoreguidelines-pro-bounds-pointer-arithmetic,-cppcoreguidelines-non-private-member-variables-in-classes,-cppcoreguidelines-init-variables,-cppcoreguidelines-pro-type-const-cast,-cppcoreguidelines-pro-bounds-constant-array-index,-cppcoreguidelines-owning-memory,-cppcoreguidelines-pro-type-union-access,-hicpp-named-parameter,-readability-named-parameter,-readability-avoid-nested-conditional-operator,-misc-no-recursion,-cppcoreguidelines-missing-std-forward,-cppcoreguidelines-avoid-do-while,-boost-use-ranges,-misc-confusable-identifiers'

# To add more rules, refer to the following link:
# https://clang.llvm.org/extra/clang-tidy/checks/readability-identifier-naming.html
CheckOptions:
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.StaticConstantIgnoreRegexp
    value: yy_sname # Generated by bison, so we don't care
  - key: modernize-deprecated-headers.CheckHeaderFile
    value: true
